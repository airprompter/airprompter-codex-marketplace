#!/bin/sh
# Bundled skill-upload entrypoint. Missing Python means the inline import path, never runtime installation.
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' '{"status":"error","code":"python3_required","message":"Python 3 is not available here."}'
  exit 1
fi
exec python3 -B "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/upload_runtime.py" "$@"
